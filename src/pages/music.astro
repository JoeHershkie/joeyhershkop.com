---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Music — Joey Hershkop" 
  description="Music by Joey Hershkop."
>
  <h2>Music</h2>

  <section class="music-showcase" aria-labelledby="track-heading">
    <div class="music-card">
      <h3 id="track-heading">Precipice of Something Great</h3>
      <p class="track-meta">Single &bull; Joey Hershkop</p>
      
      <audio controls preload="metadata" src="/audio/precipice-of-something-great.mp3">
        <p>Your browser does not support the audio element. You can <a href="/audio/precipice-of-something-great.mp3" download>download the audio file directly</a>.</p>
      </audio>

      <div class="music-links">
        <a href="https://joeyhershkop.bandcamp.com" target="_blank" rel="noopener noreferrer">Bandcamp &rarr;</a>
      </div>
    </div>
  </section>
</BaseLayout>
