---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Music — Joey Hershkop" 
  description="Original compositions, recordings, and musical projects by Joey Hershkop."
>
  <h2>Music</h2>
  <p class="lead-text">
    Original compositions, instrumental tracks, and sonic explorations.
  </p>

  <section class="music-showcase" aria-labelledby="track-heading">
    <div class="music-card">
      <h3 id="track-heading">Precipice of Something Great</h3>
      <p class="track-meta">Single &bull; Joey Hershkop</p>
      
      <audio controls preload="metadata" src="/audio/precipice-of-something-great.mp3">
        <p>Your browser does not support the audio element. You can <a href="/audio/precipice-of-something-great.mp3" download>download the audio file directly</a>.</p>
      </audio>

      <p>
        An evocative instrumental piece composed and produced with acoustic and ambient layers.
      </p>

      <div class="music-links">
        <a href="https://joeyhershkop.bandcamp.com" target="_blank" rel="noopener noreferrer">Listen on Bandcamp &rarr;</a>
        <a href="https://spotify.com" target="_blank" rel="noopener noreferrer">Spotify &rarr;</a>
        <a href="https://music.apple.com" target="_blank" rel="noopener noreferrer">Apple Music &rarr;</a>
      </div>
    </div>
  </section>
</BaseLayout>
